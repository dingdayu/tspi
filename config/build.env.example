# config/build.env.example
# ---------------------------------------------------------------------------
# Non-secret build configuration. Copy to config/build.env (gitignored) and
# edit. scripts/lib/common.sh sources config/build.env automatically if present.
# ---------------------------------------------------------------------------

# Parallelism for kernel/rootfs builds. Empty => nproc.
BUILD_JOBS=""

# --- Account / host identity ----------------------------------------------
TARGET_USERNAME="kvm"
TARGET_HOSTNAME="taishankvm"
TARGET_MDNS_NAME="taishankvm.local"

# --- Networking ------------------------------------------------------------
WIFI_COUNTRY="CN"
ENABLE_MDNS="1"

# Recovery AP: started only if station mode is unavailable.
ENABLE_RECOVERY_AP="1"
RECOVERY_AP_SSID="taishankvm-recovery"
# Leave empty here; real value belongs in config/local.env. Must be >= 8 chars.
RECOVERY_AP_PSK=""
RECOVERY_AP_TIMEOUT="60"
RECOVERY_AP_ADDRESS="192.168.66.1/24"

# --- SSH -------------------------------------------------------------------
# Public key file on the BUILD HOST to authorize for TARGET_USERNAME.
SSH_PUBLIC_KEY_FILE=""
# 0 = key-only (production). 1 = also allow password auth (development only).
ALLOW_PASSWORD_SSH="0"

# --- ADB debug option ------------------------------------------------------
# 0 = disabled/masked (production). 1 = allow opt-in helper scripts.
ENABLE_ADB_DEBUG="0"

# --- Build toggles ---------------------------------------------------------
# Set to 1 to run `make baseline` before patching (recommended first build).
RUN_BASELINE_FIRST="1"
