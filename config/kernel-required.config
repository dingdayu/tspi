# config/kernel-required.config
# ---------------------------------------------------------------------------
# Kernel symbols that MUST be present in the EFFECTIVE generated .config.
# scripts/kernel/verify.sh checks these against the real .config, not defconfig.
#
# Format: CONFIG_SYMBOL=value  (value = y or m). Lines starting with '#' are
# requirements with an expected value; bare 'CONFIG_X' means "must be set".
# ---------------------------------------------------------------------------

# --- USB Gadget / ConfigFS -------------------------------------------------
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_TUN=y

# --- Media / UVC capture ---------------------------------------------------
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_SND_USB_AUDIO=m

# --- DWC3 (USB device controller) ------------------------------------------
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_GADGET=y
