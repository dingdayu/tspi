# config/local.env.example
# ---------------------------------------------------------------------------
# SECRETS GO HERE. Copy to config/local.env (gitignored) and fill in.
# Never commit config/local.env. Never echo these values to logs.
# ---------------------------------------------------------------------------

# --- Station-mode Wi-Fi (primary network) ----------------------------------
WIFI_SSID=""
WIFI_PSK=""
WIFI_COUNTRY="CN"

# --- SSH authorized key (path on the build host) ---------------------------
SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_ed25519.pub"
ALLOW_PASSWORD_SSH="0"

# --- Recovery AP password (if ENABLE_RECOVERY_AP=1) ------------------------
# Must be >= 8 characters (WPA2). Do not ship a universal hard-coded password.
RECOVERY_AP_PSK=""
