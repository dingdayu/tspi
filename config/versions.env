# config/versions.env
# ---------------------------------------------------------------------------
# Pinned, NON-SECRET versions and identifiers. Sourced by scripts/lib/common.sh.
# Do not put credentials here; put them in config/local.env (gitignored).
# ---------------------------------------------------------------------------

# --- Vendor SDK ------------------------------------------------------------
SDK_NAME="tspi_1m_linux_kernel6.1_sdk_20260807"
SDK_RELEASE="20260807"
# Directory names used for intake/working trees (detection also accepts variants).
SDK_VENDOR_DIRNAME="tspi_1m_linux_kernel6.1_sdk_20260807"
SDK_WORK_DIRNAME="tspi-linux-sdk"

# Board config / kernel selectors detected inside the SDK (patterns, not paths).
SDK_CHIP_DIRNAME="rk3566_rk3568"
SDK_BOARD_DEFCONFIG_GLOB="*taishanpi*_defconfig"
SDK_KERNEL_VERSION="6.1"

# --- Target platform -------------------------------------------------------
TARGET_ARCH="arm64"
TARGET_SOC="rk3566"
TARGET_BOARD="tspi-rk3566"          # TaishanPi / 泰山派 RK3566 (1M class)
KERNEL_FLAVOR="rockchip-6.1"

# --- One-KVM (Rust) --------------------------------------------------------
# Pinned to the latest STABLE release (v260921/0.2.7 is a prerelease).
# Source of truth: https://github.com/mofeng-git/One-KVM/releases
ONE_KVM_VERSION="0.2.6"
ONE_KVM_TAG="v260802"
ONE_KVM_DEB="one-kvm_0.2.6_arm64.deb"
ONE_KVM_DEB_URL="https://github.com/mofeng-git/One-KVM/releases/download/v260802/one-kvm_0.2.6_arm64.deb"
# Optional China mirror (only carries 0.2.6):
ONE_KVM_DEB_URL_MIRROR="http://mirrors.ha.edu.cn/github-release/mofeng-git/One-KVM/LatestRelease/one-kvm_0.2.6_arm64.deb"
# Fill in after the first verified download (no upstream SHA256SUMS asset is published).
ONE_KVM_SHA256=""
ONE_KVM_PKG_BASENAME="one-kvm"
ONE_KVM_SERVICE="one-kvm.service"
ONE_KVM_BIN="/usr/bin/one-kvm"
ONE_KVM_DATA_DIR="/etc/one-kvm"
ONE_KVM_HTTP_PORT="8080"
ONE_KVM_HTTPS_PORT="8443"
# One-KVM 0.2.x links libc >= 2.36 => target rootfs must be Debian 12+ / Ubuntu 24.04+.
ONE_KVM_MIN_GLIBC="2.36"

# --- Builder image ---------------------------------------------------------
BUILDER_IMAGE="taishanpi-kvm-builder"
BUILDER_TAG="22.04"
BUILDER_IMAGE_REF="${BUILDER_IMAGE}:${BUILDER_TAG}"
UBUNTU_MIRROR="https://mirrors.cernet.edu.cn/ubuntu/"
